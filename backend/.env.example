# Broker MQTT
MQTT_URL=mqtts://<host>:8883
MQTT_USERNAME=backend-groupeX
MQTT_PASSWORD=
MQTT_GROUP=groupeX

# Serveur HTTP + WebSocket
PORT=3000

# Base SQLite
DB_PATH=./data.db

# Authentification
AUTH_USERNAME=groupeX
# Généré par : npm run hash-password -- '<mot de passe>'
AUTH_PASSWORD_HASH=1st-output
JWT_SECRET=second-output
JWT_TTL=15m

# Origines web autorisées
CORS_ORIGINS=http://localhost:8081
