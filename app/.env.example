# Copy to .env and fill in. Never commit .env.
# EXPO_PUBLIC_* values are inlined into the app bundle: only non-secret values here.

# LAN IP of the laptop running the backend, NOT localhost (the phone is not the laptop).
EXPO_PUBLIC_API_URL=http://192.168.1.10:3000

# WebSocket endpoint of the same backend.
EXPO_PUBLIC_WS_URL=ws://192.168.1.10:3000

# Device shown on the dashboard.
EXPO_PUBLIC_DEVICE_ID=esp-01
